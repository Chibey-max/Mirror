# `fixture` is safe for local UI work. Release builds must use `live`.
NEXT_PUBLIC_MIRROR_MODE=fixture

# Required in live mode for WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public browser endpoints. The runner uses its own private provider key.
NEXT_PUBLIC_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Before a live build, finalize deployments/46630.json and deployments/421614.json,
# then run `npm run sync:deployments`. Live mode rejects every zero core address.
